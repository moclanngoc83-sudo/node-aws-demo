<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title><%= story.title %></title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 800px; margin: auto; padding: 20px; line-height: 1.6; background: #f9f9f9; color: #333; }
        .back-link { text-decoration: none; color: #007bff; font-weight: bold; }
        .story-header { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); margin-top: 15px; }
        .chapter-list { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); margin-top: 20px; }
        .chapter-list ul { list-style: none; padding: 0; }
        .chapter-list li { padding: 10px 0; border-bottom: 1px solid #eee; }
        .chapter-list li:last-child { border-bottom: none; }
        .chapter-list a { text-decoration: none; color: #333; font-weight: bold; }
        .chapter-list a:hover { color: #007bff; }
        .badge { background: #e9ecef; padding: 3px 8px; border-radius: 4px; font-size: 14px; color: #495057; font-weight: bold; }
        .btn-link { color: #007bff; text-decoration: none; font-weight: bold; margin-left: 5px; }
        .btn-link:hover { text-decoration: underline; }
    </style>
</head>
<body>

    <a href="/" class="back-link">← Quay lại Trang chủ</a>

    <!-- Khối thông tin chi tiết bộ truyện -->
    <div class="story-header">
        <h1 style="margin-top: 0;"><%= story.title %></h1>

        <p>
            Tác giả: <b><%= story.author_name %></b> |
            Thể loại: <span class="badge"><%= story.category || 'Khác' %></span>

            <% if (user && (user.id === story.author_id || user.role === 'admin')) { %>
                — <a href="/author/edit-story/<%= story.id %>" class="btn-link">[Sửa Thông Tin Truyện]</a>
            <% } %>
        </p>

        <p><b>Mô tả:</b> <%= story.description %></p>
    </div>

    <!-- Khối danh sách chương -->
    <div class="chapter-list">
        <h3>Danh Sách Chương:</h3>

        <% if (chapters && chapters.length > 0) { %>
            <ul>
                <% chapters.forEach(chap => { %>
                    <li>
                        <a href="/chapter/<%= chap.id %>">Chương <%= chap.chapter_number %>: <%= chap.title %></a>
                        <% if (user && (user.id === story.author_id || user.role === 'admin')) { %>
                            — <a href="/author/edit-chapter/<%= chap.id %>" class="btn-link">[Sửa]</a>
                        <% } %>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p>Truyện này chưa có chương nào.</p>
        <% } %>
    </div>

</body>
</html>
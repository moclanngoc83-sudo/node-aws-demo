<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Sửa Thông Tin Truyện - <%= story.title %></title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 700px; margin: auto; padding: 20px; line-height: 1.6; }
        .form-group { margin-bottom: 15px; }
        label { font-weight: bold; display: block; margin-bottom: 5px; }
        input[type="text"], select, textarea { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
        .btn { background-color: #28a745; color: white; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; font-size: 16px; font-weight: bold; }
        .btn-cancel { background-color: #6c757d; text-decoration: none; display: inline-block; margin-left: 10px; color: white; padding: 10px 20px; border-radius: 4px; }
    </style>
</head>
<body>
    <a href="/story/<%= story.id %>">← Quay lại chi tiết truyện</a>
    <h2>Sửa Thông Tin Truyện</h2>

    <form method="POST" action="/author/edit-story/<%= story.id %>">
        <div class="form-group">
            <label>Tên truyện:</label>
            <input type="text" name="title" value="<%= story.title %>" required>
        </div>

        <div class="form-group">
            <label>Thể loại:</label>
            <select name="category">
                <% categories.forEach(cat => { %>
                    <option value="<%= cat.name %>" <%= story.category === cat.name ? 'selected' : '' %>>
                        <%= cat.name %>
                    </option>
                <% }) %>
            </select>
        </div>

        <div class="form-group">
            <label>Mô tả ngắn:</label>
            <textarea name="description" rows="5" required><%= story.description %></textarea>
        </div>

        <button type="submit" class="btn">Lưu Thay Đổi</button>
        <a href="/story/<%= story.id %>" class="btn-cancel">Hủy</a>
    </form>
</body>
</html>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Web Đọc Truyện Online</title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0; padding: 0;
            background-color: #f4f6f9;
            color: #333;
        }

        /* Thanh Menu top */
        .nav {
            background: #78cfa0;
            padding: 14px 24px;
            display: flex;
            align-items: center;
            gap: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            position: relative;
            z-index: 1000;
        }

        /* Chữ trên thanh Menu (Đồng bộ Trang Chủ & Thể loại) */
        .nav a, .dropdown-trigger {
            color: #f8fafc;
            text-decoration: none;
            font-weight: bold;
            font-size: 15px;
            transition: color 0.2s;
            cursor: pointer;
            display: inline-block;
            padding: 6px 0;
        }

        /* Đổi màu chữ sang xanh đậm khi rê chuột vào */
        .nav a:hover, .dropdown:hover .dropdown-trigger {
            color: #035935;
        }

        /* Vùng bọc Dropdown để nhận sự kiện hover */
        .dropdown {
            position: relative;
            display: inline-block;
        }

        /* --- MEGA MENU THỂ LOẠI (Tự hiện khi hover) --- */
        .mega-menu {
            display: none;
            position: absolute;
            top: 100%;
            left: -20px;
            width: 780px;
            max-width: calc(100vw - 48px);
            background: rgba(18, 28, 24, 0.94);
            backdrop-filter: blur(12px);
            border-radius: 14px;
            padding: 24px 28px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.35);
            color: #ffffff;
            z-index: 999;
        }

        /* Rê chuột vào vùng .dropdown thì tự động bật bảng .mega-menu */
        .dropdown:hover .mega-menu {
            display: block;
            animation: fadeInDown 0.2s ease;
        }

        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .mega-menu-title {
            margin: 0 0 18px 0;
            font-size: 18px;
            font-weight: 700;
            color: #ffffff;
            border-bottom: 1px solid rgba(255, 255, 255, 0.12);
            padding-bottom: 12px;
        }

        /* Chia lưới 4 cột */
        .mega-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 14px 20px;
        }
        .mega-grid a {
            color: #e2e8f0;
            font-weight: 500;
            font-size: 14px;
            padding: 6px 8px;
            border-radius: 6px;
            transition: all 0.2s;
            display: block;
        }
        .mega-grid a:hover {
            color: #78cfa0;
            background: rgba(255, 255, 255, 0.08);
            transform: translateX(3px);
        }
        .mega-grid a.active {
            color: #78cfa0;
            font-weight: 700;
        }

        .container { max-width: 960px; margin: 30px auto; padding: 0 20px; }

        /* Khung Tìm kiếm */
        .filter-box {
            background: white;
            padding: 18px 20px;
            border-radius: 10px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            margin-bottom: 25px;
        }
        .search-input {
            flex: 1; padding: 10px 14px;
            background-color: #f8fafc;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-size: 15px; outline: none;
            transition: border-color 0.2s;
        }
        .search-input:focus { border-color: #035935; }
        .btn-search {
            background: #78cfa0; color: white;
            border: none; padding: 10px 20px;
            border-radius: 6px; cursor: pointer;
            font-weight: 600; transition: all 0.2s;
        }
        .btn-search:hover { background: #318c5b; color: #fef08a; }
        .btn-search:active { background: #035935; color: #ffffff; }
        .btn-clear {
            padding: 10px 14px;
            background: #64748b;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
        }

        /* Card bộ truyện */
        .card {
            background: white;
            padding: 20px;
            margin-bottom: 16px;
            border-radius: 10px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }
        .card h3 { margin: 0 0 8px 0; }
        .card h3 a { color: #0f172a; text-decoration: none; font-size: 20px; }
        .card h3 a:hover { color: #035935; }

        .btn-delete {
            background: #ef4444; color: white;
            border: none; padding: 6px 12px;
            border-radius: 6px; cursor: pointer;
            font-size: 13px; font-weight: 600;
        }
    </style>
</head>
<body>

    <!-- Thanh Navigation -->
    <div class="nav">
        <a href="/">Trang Chủ</a>

        <!-- Cụm Thể loại tự động xổ popup khi rê chuột -->
        <div class="dropdown">
            <span class="dropdown-trigger">Thể loại ▾</span>

            <div class="mega-menu">
                <h4 class="mega-menu-title">Danh Mục Thể Loại Truyện</h4>
                <div class="mega-grid">
                    <a href="/?search=<%= encodeURIComponent(searchQuery) %>" class="<%= selectedCategory === 'All' ? 'active' : '' %>">
                        Tất cả truyện
                    </a>
                    <% categories.forEach(cat => { %>
                        <a href="/?category=<%= encodeURIComponent(cat.name) %>&search=<%= encodeURIComponent(searchQuery) %>"
                           class="<%= selectedCategory === cat.name ? 'active' : '' %>">
                            <%= cat.name %>
                        </a>
                    <% }) %>
                </div>
            </div>
        </div>

        <% if (user) { %>
            <span style="color: #035935; font-size: 14px;">Chào, <b><%= user.username %></b> (<%= user.role %>)</span>

            <% if (user.role === 'author' || user.role === 'admin') { %>
                <a href="/author">Khu vực Tác Giả</a>
            <% } %>

            <% if (user.role === 'admin') { %>
                <a href="/admin">Khu vực Admin</a>
            <% } %>

            <form method="POST" action="/user/delete-own-account" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn XÓA TÀI KHOẢN này vĩnh viễn?');">
                <button type="submit" class="btn-delete">Xóa Tài Khoản</button>
            </form>

            <a href="/logout" style="margin-left: auto;">Đăng Xuất</a>
        <% } else { %>
            <div style="margin-left: auto;">
                <a href="/login" style="margin-right: 12px;">Đăng Nhập</a>
                <a href="/register">Đăng Ký</a>
            </div>
        <% } %>
    </div>

    <!-- Nội dung chính -->
    <div class="container">
        <h2>
            Danh Sách Truyện
            <% if (selectedCategory && selectedCategory !== 'All') { %>
                — Thể loại: <span style="color: #035935;"><%= selectedCategory %></span>
            <% } %>
        </h2>

        <!-- Ô Tìm kiếm -->
        <div class="filter-box">
            <form method="GET" action="/" style="display: flex; gap: 10px;">
                <% if (selectedCategory && selectedCategory !== 'All') { %>
                    <input type="hidden" name="category" value="<%= selectedCategory %>">
                <% } %>
                <input type="text" name="search" value="<%= searchQuery %>" placeholder="Nhập tên truyện cần tìm..." class="search-input">
                <button type="submit" class="btn-search">Tìm kiếm</button>
                <% if (searchQuery || (selectedCategory && selectedCategory !== 'All')) { %>
                    <a href="/" class="btn-clear">Bỏ lọc</a>
                <% } %>
            </form>
        </div>

        <!-- Danh sách truyện -->
        <% if (stories && stories.length > 0) { %>
            <% stories.forEach(story => { %>
                <div class="card">
                    <h3><a href="/story/<%= story.id %>"><%= story.title %></a></h3>
                    <p>
                        Tác giả: <b><%= story.author_name %></b> |
                        Thể loại: <span style="background: #e9ecef; padding: 2px 8px; border-radius: 4px; font-weight: bold;"><%= story.category || 'Khác' %></span>
                    </p>
                    <p><%= story.description %></p>
                </div>
            <% }) %>
        <% } else { %>
            <div class="card">
                <p>Không tìm thấy bộ truyện nào phù hợp với từ khóa/thể loại đã chọn.</p>
            </div>
        <% } %>
    </div>

</body>
</html>
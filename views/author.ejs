<!DOCTYPE html>
<html>
<head><title>Quản Lý Tác Giả</title></head>
<body style="font-family: Arial; padding: 20px;">
    <a href="/">← Trang chủ</a>
    <h2>Khu Vực Dành Cho Tác Giả</h2>

    <h3>Đăng Truyện Mới</h3>
    <form method="POST" action="/author/create-story">
        <div>
            <label>Tiêu đề truyện:</label><br>
            <input type="text" name="title" required style="width: 100%; padding: 8px;">
        </div><br>

        <div>
            <label>Thể loại:</label><br>
            <select name="category" style="width: 100%; padding: 8px;">
                <option value="Tiên Hiệp">Tiên Hiệp</option>
                <option value="Kiếm Hiệp">Kiếm Hiệp</option>
                <option value="Ngôn Tình">Ngôn Tình</option>
                <option value="Đô Thị">Đô Thị</option>
                <option value="Kinh Dị">Kinh Dị</option>
                <option value="Khoa Học Viễn Tưởng">Khoa Học Viễn Tưởng</option>
                <option value="Hành Động">Hành Động</option>
            </select>
        </div><br>

        <div>
            <label>Mô tả ngắn:</label><br>
            <textarea name="description" rows="4" style="width: 100%; padding: 8px;" required></textarea>
        </div><br>

        <button type="submit" style="padding: 10px 20px; background: #28a745; color: white; border: none; cursor: pointer;">Đăng Truyện</button>
    </form>

    <hr>
    <h3>Truyện Đã Đăng Của Tôi:</h3>
    <ul>
        <% stories.forEach(s => { %>
            <li><b><%= s.title %></b> - <a href="/story/<%= s.id %>">Quản lý chương</a></li>
        <% }) %>
    </ul>
</body>
</html>
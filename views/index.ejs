<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Web Đọc Truyện Online</title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0; padding: 0;
            background-color: #f4f6f9;
            color: #333;
        }

        /* Thanh Menu top */
        .nav {
            background: #78cfa0;
            padding: 12px 24px;
            display: flex;
            align-items: center;
            gap: 18px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            position: relative;
            z-index: 1000;
            flex-wrap: wrap;
        }

        /* Chữ trên thanh Menu */
        .nav a, .dropdown-trigger {
            color: #f8fafc;
            text-decoration: none;
            font-weight: bold;
            font-size: 15px;
            transition: color 0.2s;
            cursor: pointer;
            display: inline-block;
            padding: 6px 0;
        }

        /* Đổi sang xanh đậm khi di chuột hoặc ấn giữ */
        .nav a:hover, .nav a:active,
        .dropdown:hover .dropdown-trigger, .dropdown-trigger:active {
            color: #035935;
        }

        /* --- THANH TÌM KIẾM TRÊN MENU BAR --- */
        .nav-search-form {
            display: flex;
            align-items: center;
            gap: 6px;
            margin: 0 10px;
            flex: 1;
            max-width: 380px;
        }
        .nav-search-input {
            width: 100%;
            padding: 7px 14px;
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.92);
            color: #0f172a;
            font-size: 14px;
            outline: none;
            transition: all 0.2s;
        }
        .nav-search-input:focus {
            background: #ffffff;
            border-color: #035935;
            box-shadow: 0 0 0 2px rgba(3, 89, 53, 0.2);
        }
        .nav-btn-search {
            background: #318c5b;
            color: #ffffff;
            border: none;
            padding: 7px 15px;
            border-radius: 20px;
            cursor: pointer;
            font-weight: bold;
            font-size: 13px;
            white-space: nowrap;
            transition: all 0.2s;
        }
        /* Hiệu ứng chữ chuyển xanh đậm khi di chuột / ấn vào */
        .nav-btn-search:hover, .nav-btn-search:active {
            background: #ffffff;
            color: #035935;
        }
        .nav-btn-clear {
            background: rgba(15, 23, 42, 0.35);
            color: #ffffff;
            text-decoration: none;
            padding: 6px 11px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
            transition: all 0.2s;
        }
        .nav-btn-clear:hover {
            background: #ffffff;
            color: #035935;
        }

        /* Vùng bọc Dropdown Thể loại */
        .dropdown {
            position: relative;
            display: inline-block;
        }

        /* --- MEGA MENU THỂ LOẠI --- */
        .mega-menu {
            display: none;
            position: absolute;
            top: 100%;
            left: -20px;
            width: 780px;
            max-width: calc(100vw - 48px);
            background: rgba(18, 28, 24, 0.94);
            backdrop-filter: blur(12px);
            border-radius: 14px;
            padding: 24px 28px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.35);
            color: #ffffff;
            z-index: 999;
        }
        .dropdown:hover .mega-menu {
            display: block;
            animation: fadeInDown 0.2s ease;
        }
        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-8px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .mega-menu-title {
            margin: 0 0 18px 0;
            font-size: 18px;
            font-weight: 700;
            color: #ffffff;
            border-bottom: 1px solid rgba(255, 255, 255, 0.12);
            padding-bottom: 12px;
        }
        .mega-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 14px 20px;
        }
        .mega-grid a {
            color: #e2e8f0;
            font-weight: 500;
            font-size: 14px;
            padding: 6px 8px;
            border-radius: 6px;
            transition: all 0.2s;
            display: block;
        }
        .mega-grid a:hover {
            color: #78cfa0;
            background: rgba(255, 255, 255, 0.08);
            transform: translateX(3px);
        }
        .mega-grid a.active {
            color: #78cfa0;
            font-weight: 700;
        }

        .container { max-width: 960px; margin: 30px auto; padding: 0 20px; }

        /* Card bộ truyện */
        .card {
            background: white;
            padding: 20px;
            margin-bottom: 16px;
            border-radius: 10px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }
        .card h3 { margin: 0 0 8px 0; }
        .card h3 a { color: #0f172a; text-decoration: none; font-size: 20px; }
        .card h3 a:hover { color: #035935; }

        .btn-delete {
            background: #ef4444; color: white;
            border: none; padding: 6px 12px;
            border-radius: 6px; cursor: pointer;
            font-size: 13px; font-weight: 600;
        }
    </style>
</head>
<body>

    <!-- Thanh Navigation tích hợp sẵn tìm kiếm -->
    <div class="nav">
        <a href="/">Trang Chủ</a>

        <!-- Dropdown Thể loại -->
        <div class="dropdown">
            <span class="dropdown-trigger">Thể loại ▾</span>

            <div class="mega-menu">
                <h4 class="mega-menu-title">Danh Mục Thể Loại Truyện</h4>
                <div class="mega-grid">
                    <a href="/?search=<%= encodeURIComponent(searchQuery) %>" class="<%= selectedCategory === 'All' ? 'active' : '' %>">
                        Tất cả truyện
                    </a>
                    <% categories.forEach(cat => { %>
                        <a href="/?category=<%= encodeURIComponent(cat.name) %>&search=<%= encodeURIComponent(searchQuery) %>"
                           class="<%= selectedCategory === cat.name ? 'active' : '' %>">
                            <%= cat.name %>
                        </a>
                    <% }) %>
                </div>
            </div>
        </div>

        <!-- Thanh Tìm Kiếm nằm ngay trên Menu Bar -->
        <form method="GET" action="/" class="nav-search-form">
            <% if (selectedCategory && selectedCategory !== 'All') { %>
                <input type="hidden" name="category" value="<%= selectedCategory %>">
            <% } %>
            <input type="text" name="search" value="<%= searchQuery %>" placeholder="Tìm tên truyện..." class="nav-search-input">
            <button type="submit" class="nav-btn-search">Tìm kiếm</button>
            <% if (searchQuery || (selectedCategory && selectedCategory !== 'All')) { %>
                <a href="/" class="nav-btn-clear">Bỏ lọc</a>
            <% } %>
        </form>

        <!-- Phần tài khoản bên phải -->
        <div style="margin-left: auto; display: flex; align-items: center; gap: 15px;">
            <% if (user) { %>
                <span style="color: #035935; font-size: 14px;">Chào, <b><%= user.username %></b> (<%= user.role %>)</span>

                <% if (user.role === 'author' || user.role === 'admin') { %>
                    <a href="/author">Khu vực Tác Giả</a>
                <% } %>

                <% if (user.role === 'admin') { %>
                    <a href="/admin">Khu vực Admin</a>
                <% } %>

                <form method="POST" action="/user/delete-own-account" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn XÓA TÀI KHOẢN này vĩnh viễn?');">
                    <button type="submit" class="btn-delete">Xóa Tài Khoản</button>
                </form>

                <a href="/logout">Đăng Xuất</a>
            <% } else { %>
                <a href="/login">Đăng Nhập</a>
                <a href="/register">Đăng Ký</a>
            <% } %>
        </div>
    </div>

    <!-- Nội dung chính -->
    <div class="container">
        <h2>
            Danh Sách Truyện Mới Cập Nhật
            <% if (selectedCategory && selectedCategory !== 'All') { %>
                — Thể loại: <span style="color: #035935;"><%= selectedCategory %></span>
            <% } %>
            <% if (searchQuery) { %>
                — Từ khóa: "<span style="color: #035935;"><%= searchQuery %></span>"
            <% } %>
        </h2>

        <!-- Danh sách truyện -->
        <% if (stories && stories.length > 0) { %>
            <% stories.forEach(story => { %>
                <div class="card">
                    <h3><a href="/story/<%= story.id %>"><%= story.title %></a></h3>
                    <p>
                        Tác giả: <b><%= story.author_name %></b> |
                        Thể loại: <span style="background: #e9ecef; padding: 2px 8px; border-radius: 4px; font-weight: bold;"><%= story.category || 'Khác' %></span>
                    </p>
                    <p><%= story.description %></p>
                </div>
            <% }) %>
        <% } else { %>
            <div class="card">
                <p>Không tìm thấy bộ truyện nào phù hợp với từ khóa/thể loại đã chọn.</p>
            </div>
        <% } %>
    </div>

</body>
</html>